---
// Standalone marketing landing page for The Desk, served from the apex.
// The documentation lives on its own origin at https://docs.thedeskhq.app.

// The app's palette, generated out of deskhq/the-desk's app.css. Never edit it
// here — run `npm run sync:upstream`. The semantic aliases below map this
// page's vocabulary onto those tokens.
import '../styles/tokens.css';

// The synced shell captures, imported rather than linked out of public/ so the
// build can re-encode them. They are PNG screenshots of a text-dense UI —
// several hundred KB each — and WebP at this quality halves them without
// smearing the type. Every capture keeps its PNG as the <picture> fallback.
import { getImage } from 'astro:assets';
import desktopLight from '../assets/shell/desktop-light.png';
import desktopDark from '../assets/shell/desktop-dark.png';
import mobileLight from '../assets/shell/mobile-light.png';
import mobileDark from '../assets/shell/mobile-dark.png';

const shot = async (src) => ({
	webp: (await getImage({ src, format: 'webp', quality: 78 })).src,
	png: src.src,
	width: src.width,
	height: src.height,
});
const shell = {
	desktopLight: await shot(desktopLight),
	desktopDark: await shot(desktopDark),
	mobileLight: await shot(mobileLight),
	mobileDark: await shot(mobileDark),
};

const site = 'https://thedeskhq.app';
const github = 'https://github.com/deskhq/the-desk';
const docs = 'https://docs.thedeskhq.app/';
const installGuide = 'https://docs.thedeskhq.app/self-hosting/installation/';
// Identity and hardening are claimed on this page, so link the settings that
// deliver them: every claim below is a documented toggle or env block.
const configGuide = 'https://docs.thedeskhq.app/self-hosting/configuration/';
const featureToggles = 'https://docs.thedeskhq.app/reference/feature-toggles/';
// The rendered reference, not the raw YAML: this is where a reader browses
// operation by operation. The spec itself is published beside it.
const apiReference = 'https://docs.thedeskhq.app/api-reference/';
const openapiSpec = 'https://docs.thedeskhq.app/openapi.yaml';
const brandingGuide = 'https://docs.thedeskhq.app/self-hosting/branding/';
const dokployGuide = 'https://docs.thedeskhq.app/self-hosting/dokploy/';
// A live instance seeded with the demo workspace; its login page prints the
// shared credentials, so nothing on the page should promise a signup flow.
const demo = 'https://demo.thedeskhq.app/';
// Both strings are kept inside the lengths search engines render without
// truncating: roughly 60 characters for the title, 160 for the description.
const title = 'Self-hosted team chat on your own server — The Desk';
const description =
	'A calm, fast, open-source Slack alternative you host yourself: channels, threads, reminders and scheduled messages. One container, your hardware, your data.';
const ogImage = `${site}/og-image.png`;
const fontCss =
	'https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap';

// Rich-result structured data: a free, self-hostable web application.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'The Desk',
	description,
	url: `${site}/`,
	applicationCategory: 'CommunicationApplication',
	operatingSystem: 'Docker / Linux',
	license: 'https://opensource.org/licenses/MIT',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	author: { '@type': 'Organization', name: 'deskhq', url: 'https://github.com/deskhq' },
};

// Google Analytics 4. The measurement ID is read from the environment rather
// than written down here, so local dev, preview branches and forks stay out of
// production's numbers: with the variable unset nothing below renders, no
// request reaches googletagmanager, and the consent banner never ships.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Consent Mode v2, declared before gtag.js is even fetched: every signal starts
// denied, so GA4's first ping is cookieless and stays that way until the banner
// says otherwise. The three ad_* signals are never updated — this site runs no
// ads. src/scripts/analytics.ts owns the flip; all this does is stand up
// window.gtag so the rest of the page has something to talk to.
const gaBootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
	ad_storage: 'denied',
	ad_user_data: 'denied',
	ad_personalization: 'denied',
	analytics_storage: 'denied',
	wait_for_update: 500,
});
gtag('js', new Date());
gtag('config', ${JSON.stringify(gaMeasurementId)});
`.trim();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={`${site}/`} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${site}/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		{gaMeasurementId && <link rel="preconnect" href="https://www.googletagmanager.com" />}
		{/*
		  Fetched at stylesheet priority but applied out of the critical path:
		  `media="print"` means the browser does not block the first render on a
		  round trip to fonts.googleapis.com, and the onload flips it back the
		  moment it lands. The faces already carry `display=swap`, so the page
		  paints in the fallback either way — this only stops the wait.
		*/}
		<link rel="preload" as="style" href={fontCss} />
		<link rel="stylesheet" href={fontCss} media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href={fontCss} /></noscript>
		{
			gaMeasurementId && (
				<Fragment>
					<script is:inline set:html={gaBootstrap} />
					<script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
				</Fragment>
			)
		}
	</head>
	<body>
		<!-- ============================ NAV ============================ -->
		<header class="nav">
			<div class="nav-inner">
				<a class="brand" href="/">
					<svg width="26" height="26" viewBox="0 0 40 40" aria-hidden="true">
						<polygon points="20,18 36,27 20,36 4,27" fill="#1d1a15" opacity="0.4"></polygon>
						<polygon points="20,11 36,20 20,29 4,20" fill="#1d1a15" opacity="0.7"></polygon>
						<polygon points="20,4 36,13 20,22 4,13" fill="#c9a35c"></polygon>
					</svg>
					<span class="serif brand-name">The Desk</span>
				</a>
				<nav class="nav-links">
					<a class="nav-link" href="#features">Features</a>
					<a class="nav-link" href="#selfhost">Self-hosting</a>
					<a class="nav-link" href={demo} target="_blank" rel="noopener" data-cta="live_demo" data-placement="nav">Live demo</a>
					<a class="nav-link" href={docs} data-cta="docs" data-placement="nav">Docs</a>
					<a class="btn btn-dark btn-sm" href={github} data-cta="github" data-placement="nav">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="#f3efe4" aria-hidden="true"
							><path
								d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.84c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.16.58.67.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"
							></path></svg
						>
						GitHub
					</a>
				</nav>
				<button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
					</svg>
				</button>
			</div>
		</header>

		<main>
			<!-- ============================ HERO ============================ -->
			<section class="hero">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<span class="eyebrow-brass serif">
							<svg width="14" height="14" viewBox="0 0 40 40" aria-hidden="true">
								<polygon points="20,18 36,27 20,36 4,27" fill="#7d6023" opacity="0.35"></polygon>
								<polygon points="20,11 36,20 20,29 4,20" fill="#7d6023" opacity="0.6"></polygon>
								<polygon points="20,4 36,13 20,22 4,13" fill="#c9a35c"></polygon>
							</svg>
							Open source, self-hosted team chat
						</span>
						<h1 class="serif hero-title">Team chat that lives on your own server</h1>
						<p class="hero-lede">
							The Desk is a calm, fast, self-hosted Slack alternative: channels, threads, reminders,
							scheduled messages. One container, your hardware, your data. No per-seat pricing, because
							there's no one to pay.
						</p>
						<div class="hero-actions">
							<a class="btn btn-dark btn-lg" href={installGuide} data-cta="install_guide" data-placement="hero">
								Deploy in 5 minutes
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
									><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
								>
							</a>
							<a class="btn btn-outline btn-lg" href={demo} target="_blank" rel="noopener" data-cta="live_demo" data-placement="hero">Try the live demo</a>
						</div>
						<p class="hero-demo-note">
							No signup, no install — the demo's login page shows the shared credentials.
						</p>
						<div class="hero-install">
							<span class="mono-chip">docker compose pull &amp;&amp; docker compose up -d</span>
							<span>and it's installed. Prebuilt image, no build step.</span>
						</div>
					</div>

					<!--
					  The real shell, synced from deskhq/the-desk's `bin/capture-shell`
					  output. Intrinsic width/height are the captures' true pixel sizes so
					  the hero reserves its box before the image lands. WebP first at every
					  breakpoint, with the PNG behind it for anything that cannot take it.
					-->
					<div class="preview">
						<picture>
							<source srcset={shell.mobileLight.webp} type="image/webp" media="(max-width: 767px)" width={shell.mobileLight.width} height={shell.mobileLight.height} />
							<source srcset={shell.mobileLight.png} media="(max-width: 767px)" width={shell.mobileLight.width} height={shell.mobileLight.height} />
							<source srcset={shell.desktopLight.webp} type="image/webp" width={shell.desktopLight.width} height={shell.desktopLight.height} />
							<img
								src={shell.desktopLight.png}
								alt="The Desk's workspace: an icon rail, the channel dock, and the #product-launch channel with a pinned message, reactions and a thread"
								width={shell.desktopLight.width}
								height={shell.desktopLight.height}
								fetchpriority="high"
								decoding="async"
							/>
						</picture>
					</div>
				</div>
			</section>

			<!-- ============================ SHOWCASE ============================ -->
			<section class="showcase">
				<div class="wrap">
					<div class="section-head showcase-head">
						<span class="eyebrow eyebrow--gold">See it in action</span>
						<h2 class="serif section-title showcase-title">Your whole workspace, quietly in one&nbsp;place</h2>
						<p class="section-lede">
							Channels, threads, reactions, and direct messages: the real app, not a mockup. Light and
							dark both ship, on desktop and on mobile.
						</p>
					</div>
					<!--
					  Same synced captures as the hero, uncropped, and following the
					  reader's theme: dark preference gets the dark shot.
					-->
					<div class="showcase-frame">
						<picture>
							<source
								srcset={shell.mobileDark.webp}
								type="image/webp"
								media="(max-width: 767px) and (prefers-color-scheme: dark)"
								width={shell.mobileDark.width}
								height={shell.mobileDark.height}
							/>
							<source
								srcset={shell.mobileDark.png}
								media="(max-width: 767px) and (prefers-color-scheme: dark)"
								width={shell.mobileDark.width}
								height={shell.mobileDark.height}
							/>
							<source srcset={shell.desktopDark.webp} type="image/webp" media="(prefers-color-scheme: dark)" width={shell.desktopDark.width} height={shell.desktopDark.height} />
							<source srcset={shell.desktopDark.png} media="(prefers-color-scheme: dark)" width={shell.desktopDark.width} height={shell.desktopDark.height} />
							<source srcset={shell.mobileLight.webp} type="image/webp" media="(max-width: 767px)" width={shell.mobileLight.width} height={shell.mobileLight.height} />
							<source srcset={shell.mobileLight.png} media="(max-width: 767px)" width={shell.mobileLight.width} height={shell.mobileLight.height} />
							<source srcset={shell.desktopLight.webp} type="image/webp" width={shell.desktopLight.width} height={shell.desktopLight.height} />
							<img
								src={shell.desktopLight.png}
								alt="The Desk workspace: the icon rail and channel dock beside the #product-launch channel, with reactions, a pinned message and a thread"
								width={shell.desktopLight.width}
								height={shell.desktopLight.height}
								loading="lazy"
								decoding="async"
							/>
						</picture>
					</div>
				</div>
			</section>

			<!-- ============================ POWERED BY ============================ -->
			<section class="powered">
				<div class="wrap powered-grid">
					<div class="powered-intro">
						<span class="eyebrow eyebrow--brass">Powered by</span>
						<h2 class="serif powered-title">A boring stack you already know how to run</h2>
						<p class="powered-lede">One compose file, a handful of containers. No Kubernetes, no exotic dependencies.</p>
					</div>
					<!--
					  The marks are Simple Icons (CC0), vendored into public/tech at the
					  cream fill this section needs rather than fetched from their CDN:
					  seven third-party requests, each served with a cache lifetime we do
					  not control, for seven files totalling under 10 KB.
					-->
					<div class="stack-grid">
						<div class="stack-card">
							<img src="/tech/laravel.svg" alt="Laravel" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">Laravel 13</span><span class="stack-desc">Application framework, queues &amp; scheduler</span></div>
						</div>
						<div class="stack-card">
							<img src="/tech/vuedotjs.svg" alt="Vue.js" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">Vue 3</span><span class="stack-desc">Frontend, served through Inertia</span></div>
						</div>
						<div class="stack-card">
							<img src="/tech/inertia.svg" alt="Inertia" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">Inertia</span><span class="stack-desc">Server-driven SPA, no separate API</span></div>
						</div>
						<div class="stack-card">
							<img src="/tech/postgresql.svg" alt="PostgreSQL" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">PostgreSQL</span><span class="stack-desc">Database, cache, sessions &amp; queue</span></div>
						</div>
						<div class="stack-card">
							<img src="/tech/meilisearch.svg" alt="Meilisearch" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">Meilisearch</span><span class="stack-desc">Instant full-text message search</span></div>
						</div>
						<div class="stack-card">
							<img src="/tech/redis.svg" alt="Redis" width="30" height="30" />
							<div class="stack-text"><span class="stack-name">Redis</span><span class="stack-desc">Cache &amp; realtime presence</span></div>
						</div>
						<div class="stack-card stack-card--wide">
							<img src="/tech/docker.svg" alt="Docker" width="38" height="38" />
							<div class="stack-text"><span class="stack-name">Docker</span><span class="stack-desc">The whole stack in one compose file: FrankenPHP app image, Reverb websockets, queue worker &amp; scheduler</span></div>
						</div>
					</div>
				</div>
			</section>

			<!-- ============================ FEATURES ============================ -->
			<section id="features" class="features">
				<div class="wrap">
					<div class="section-head">
						<span class="eyebrow eyebrow--gold">Everything a team needs</span>
						<h2 class="serif section-title">Built in, not add-ons</h2>
						<p class="section-lede">
							Channels, threads, and DMs are table stakes. The Desk also covers the workflow features
							teams actually miss when they leave the big platforms.
						</p>
					</div>
					<!--
					  Card order is deliberate: search leads, and the three cards whose
					  demos need the room — search, polls and the API — span two
					  columns, which also lands the twelve cards on five full rows
					  instead of leaving an orphan. Twelve divides evenly at two and
					  one column, where the spans collapse; see .feature-card--wide.
					-->
					<div class="feature-grid">
						<div class="feature-card feature-card--wide">
							<div class="feature-demo demo-col">
								<div class="demo-row">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b98e3f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
									<span class="demo-text">roadmap <span class="faint">— 23 messages in 4 channels</span></span>
								</div>
								<div class="demo-row demo-row--wrap">
									<span class="reaction reaction--on">from:maya</span>
									<span class="reaction">has:file</span>
									<span class="reaction">#product-launch</span>
								</div>
							</div>
							<div class="feature-text"><span class="feature-name">Search that filters</span><span class="feature-desc">Full-text search over every channel, thread and DM you can see, then narrow it by author, channel, date, or <strong>has:file</strong> to find the attachment you half-remember. Pinned in the dock, instant at any history size.</span></div>
						</div>
						<div class="feature-card">
							<div class="feature-demo demo-col">
								<span class="demo-text">Reminder: retro moved to Thursday.</span>
								<span class="scheduled-pill scheduled-pill--soft">
									<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#b98e3f" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
									Sends Mon 9:00 AM
								</span>
							</div>
							<div class="feature-text"><span class="feature-name">Scheduled messages</span><span class="feature-desc">Write now, send when it's kind to. Edit or cancel anything still in the queue.</span></div>
						</div>
						<div class="feature-card">
							<div class="feature-demo demo-row">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b98e3f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
								<span class="demo-text">Remind me about this <strong>tomorrow at 9 AM</strong></span>
							</div>
							<div class="feature-text"><span class="feature-name">Message reminders</span><span class="feature-desc">Snooze any message and it resurfaces exactly when you asked. Nothing slips.</span></div>
						</div>
						<div class="feature-card">
							<div class="feature-demo demo-col">
								<span class="demo-text">Starting a thread for icon feedback.</span>
								<span class="thread-link">
									<span class="stack"><span class="stack-a stack-a--sm"></span><span class="stack-b stack-b--sm"></span></span>
									5 replies
								</span>
							</div>
							<div class="feature-text"><span class="feature-name">Threads &amp; group DMs</span><span class="feature-desc">Side conversations stay at the side. Channels stay readable.</span></div>
						</div>
						<div class="feature-card">
							<div class="feature-demo demo-row">
								<span class="reaction reaction--on">@design</span>
								<span class="stack"><span class="stack-a stack-a--sm"></span><span class="stack-b stack-b--sm"></span></span>
								<span class="demo-text">notifies all 6</span>
							</div>
							<div class="feature-text"><span class="feature-name">User groups &amp; group mentions</span><span class="feature-desc">Mention <strong>@design</strong> or <strong>@oncall</strong> and everyone in the group hears it. Membership lives in settings, not in your head.</span></div>
						</div>
						<div class="feature-card">
							<div class="feature-demo demo-row">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b98e3f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0"></path><path d="M12 18v4"></path></svg>
								<!-- played portion of the waveform is the first five bars; the
								     heights repeat every six, so the pattern needs six rules -->
								<span class="wave" aria-hidden="true"
									><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span
								>
								<span class="demo-text faint">0:14</span>
							</div>
							<div class="feature-text"><span class="feature-name">Voice messages</span><span class="feature-desc">Record straight in the composer when typing it out would take five minutes. Plays back inline, waveform and all.</span></div>
						</div>
						<div class="feature-card feature-card--wide">
							<div class="feature-demo demo-col">
								<span class="demo-text">Retro on Thursday or Friday?</span>
								<div class="poll">
									<div class="poll-row">
										<span class="poll-label">Thursday</span>
										<span class="poll-bar"><span class="poll-fill poll-fill--lead"></span></span>
										<span class="poll-votes">7</span>
									</div>
									<div class="poll-row">
										<span class="poll-label">Friday</span>
										<span class="poll-bar"><span class="poll-fill"></span></span>
										<span class="poll-votes">4</span>
									</div>
								</div>
							</div>
