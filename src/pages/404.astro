---
// The not-found page, and the reason the rest of the site is crawlable at all.
//
// Cloudflare Pages falls back to single-page-application behaviour when a build
// ships an index.html and no 404.html: every unmatched path — /robots.txt,
// /sitemap.xml, /anything — comes back as the homepage with a 200. That hands
// crawlers an unbounded set of distinct URLs all serving identical content, and
// hands auditors HTML where they asked for text. Emitting this route is what
// makes Pages answer 404 with a 404 instead.
//
// Kept deliberately thin: its own small style block rather than a share of
// index.astro's, no analytics (a 404 is not a visit worth measuring, and the
// consent banner has no business appearing here), and no fetch beyond the two
// families the rest of the site already uses.
import '../styles/tokens.css';

const site = 'https://thedeskhq.app';
const docs = 'https://docs.thedeskhq.app/';
const github = 'https://github.com/deskhq/the-desk';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Page not found — The Desk</title>
		<meta name="description" content="That page doesn't exist on thedeskhq.app." />
		<!-- Soft or hard, a 404 has nothing to index. -->
		<meta name="robots" content="noindex, follow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..600&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main class="lost">
			<a class="brand" href={`${site}/`}>
				<svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
					<polygon points="20,18 36,27 20,36 4,27" fill="#1d1a15" opacity="0.4"></polygon>
					<polygon points="20,11 36,20 20,29 4,20" fill="#1d1a15" opacity="0.7"></polygon>
					<polygon points="20,4 36,13 20,22 4,13" fill="#c9a35c"></polygon>
				</svg>
				<span class="serif brand-name">The Desk</span>
			</a>

			<p class="code serif">404</p>
			<h1 class="serif title">There's nothing filed here</h1>
			<p class="lede">
				That address doesn't match a page on this site. The landing page has the tour, and the documentation has everything else.
			</p>

			<div class="actions">
				<a class="btn btn-dark" href="/">Back to the landing page</a>
				<a class="btn btn-outline" href={docs}>Read the docs</a>
			</div>

			<p class="footnote">
				Think this address should work? <a class="link" href={`${github}/issues`}>Open an issue</a>.
			</p>
		</main>

		<style>
			:root {
				--cream: var(--app-background);
				--ink: var(--app-foreground);
				--paper: var(--app-primary-foreground);
				--muted: var(--app-muted-foreground);
				--line: var(--app-border);
				--brass: var(--app-brass);
				--dark: var(--app-dark-background);
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				background: var(--cream);
			}
			body {
				font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
				color: var(--ink);
				-webkit-font-smoothing: antialiased;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			h1,
			p {
				margin: 0;
			}
			.serif {
				font-family: 'Newsreader', ui-serif, Georgia, serif;
				font-weight: 500;
			}

			.lost {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 18px;
				padding: 48px 20px;
				text-align: center;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				margin-bottom: 14px;
			}
			.brand-name {
				font-size: 20px;
				letter-spacing: -0.01em;
			}

			.code {
				font-size: 13px;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--brass);
			}
			.title {
				font-size: 38px;
				line-height: 1.15;
				letter-spacing: -0.02em;
				max-width: 15ch;
			}
			.lede {
				max-width: 46ch;
				font-size: 16px;
				line-height: 1.65;
				color: var(--muted);
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 12px;
				margin-top: 10px;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: 46px;
				padding: 0 22px;
				border-radius: 10px;
				font-size: 15px;
				font-weight: 500;
				border: 1px solid transparent;
				transition:
					transform 0.15s ease,
					opacity 0.15s ease;
			}
			.btn:hover {
				transform: translateY(-1px);
			}
			.btn-dark {
				background: var(--dark);
				color: var(--paper);
			}
			.btn-outline {
				border-color: var(--line);
				color: var(--ink);
			}

			.footnote {
				margin-top: 12px;
				font-size: 14px;
				color: var(--muted);
			}
			.link {
				color: var(--brass);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			@media (max-width: 640px) {
				.title {
					font-size: 30px;
				}
				.actions {
					align-self: stretch;
					flex-direction: column;
				}
				.actions .btn {
					width: 100%;
				}
			}
		</style>
	</body>
</html>
